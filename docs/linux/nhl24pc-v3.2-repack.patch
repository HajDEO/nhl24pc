+namespace Common {
+// nhlport: set by the renderer (GPU hang locator); runs once before the process stops.
+void (*fatal_hook)() = nullptr;
+}
+
 void assert_fail_impl() {
+#ifdef _WIN32
+    // nhlport: Shutdown() can wait forever on a lost GPU (the game froze instead of closing);
+    // end the process a few seconds later in any case.
+    static std::atomic<bool> watchdog_started{false};
+    if (!watchdog_started.exchange(true)) {
+        if (HANDLE thread = CreateThread(
+                nullptr, 0,
+                [](LPVOID) -> DWORD {
+                    Sleep(5000);
+                    Common::Log::Flush();
+                    TerminateProcess(GetCurrentProcess(), 0xDEAD);
+                    return 0;
+                },
+                nullptr, 0, nullptr)) {
+            CloseHandle(thread);
+        }
+    }
+#endif
+    if (auto hook = Common::fatal_hook) {
+        Common::fatal_hook = nullptr;
+        hook();
+    }
+    LogAssertBacktrace();
+    Common::Log::Flush();
     Core::Signals::Instance()->RemoveHandlers();
     Common::Singleton<Core::Emulator>::Instance()->Shutdown();
     Crash();
