+// nhlport: write the call stack of a failed assertion to the log as module+offset pairs, so a
+// crash report can be symbolized against nhl24.pdb (llvm-symbolizer) without a debugger.
+static void LogAssertBacktrace() {
+    void* frames[48];
+    const USHORT n = RtlCaptureStackBackTrace(1, 48, frames, nullptr);
+    for (USHORT i = 0; i < n; ++i) {
+        HMODULE mod = nullptr;
+        char name[MAX_PATH] = "?";
+        if (GetModuleHandleExA(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS |
+                                   GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+                               static_cast<LPCSTR>(frames[i]), &mod) &&
+            mod) {
+            char path[MAX_PATH];
+            if (GetModuleFileNameA(mod, path, MAX_PATH)) {
+                const char* base = strrchr(path, '\\');
+                strncpy_s(name, base ? base + 1 : path, _TRUNCATE);
+            }
+        }
+        const auto rva = reinterpret_cast<uintptr_t>(frames[i]) - reinterpret_cast<uintptr_t>(mod);
+        LOG_CRITICAL(Debug, "  backtrace #{:02} {}+{:#x}", i, name, rva);
+    }
+}
+#else
+static void LogAssertBacktrace() {}
+#endif
 
 #if defined(ARCH_X86_64)
