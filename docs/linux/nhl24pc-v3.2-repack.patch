+vk::DeviceMemory BufferCache::AllocateArenaMemory(u64 size) {
+    const auto device = instance.GetDevice();
+    const vk::MemoryAllocateFlagsInfo alloc_flags = {
+        .flags = vk::MemoryAllocateFlagBits::eDeviceAddress,
+    };
+    vk::Result last_result = vk::Result::eErrorOutOfDeviceMemory;
+    const auto try_type = [&](u32 type) -> vk::DeviceMemory {
+        const vk::MemoryAllocateInfo alloc_info = {
+            .pNext = &alloc_flags,
+            .allocationSize = size,
+            .memoryTypeIndex = type,
+        };
+        auto [result, memory] = device.allocateMemory(alloc_info);
+        last_result = result;
+        return result == vk::Result::eSuccess ? memory : vk::DeviceMemory{};
+    };
+
+    const bool over_test_limit =
+        arena_device_limit != 0 && arena_device_bytes + size > arena_device_limit;
+    // After VRAM ran out, only every 32nd allocation tries it again (failing allocations
+    // can be slow while the driver looks for memory to evict).
+    const bool try_device = !over_test_limit && (arena_device_skips == 0 || --arena_device_skips == 0);
+    if (try_device) {
+        if (const auto memory = try_type(arena_memory_type_index)) {
+            arena_device_bytes += size;
+            return memory;
+        }
+        // Out of VRAM: drop the images parked for reuse and try again.
+        TrimImagePool();
+        if (const auto memory = try_type(arena_memory_type_index)) {
+            arena_device_bytes += size;
+            return memory;
+        }
+        arena_device_skips = 32;
+    }
+    for (const u32 type : arena_fallback_types) {
+        const bool local =
+            static_cast<bool>(instance.GetMemoryProperties().memoryTypes[type].propertyFlags &
+                              vk::MemoryPropertyFlagBits::eDeviceLocal);
+        if (local && !try_device) {
+            continue;
+        }
+        if (const auto memory = try_type(type)) {
+            u64& bytes = local ? arena_device_bytes : arena_host_bytes;
+            const bool crossed = (bytes >> 28) != ((bytes + size) >> 28); // every 256 MB
+            bytes += size;
+            static u32 logged = 0;
+            if (logged < 3 || crossed) {
+                ++logged;
+                LOG_WARNING(Render,
+                            "buffer arena: out of VRAM, {} KB placed in memory type {} "
+                            "({} MB on GPU, {} MB in system memory)",
+                            size >> 10, type, arena_device_bytes >> 20, arena_host_bytes >> 20);
+            }
+            return memory;
+        }
+    }
+    ASSERT_MSG(false,
+               "Out of video memory for game buffers: {} ({} MB on GPU, {} MB in system "
+               "memory, request {} KB)",
+               vk::to_string(last_result), arena_device_bytes >> 20, arena_host_bytes >> 20,
+               size >> 10);
+    return {};
+}
