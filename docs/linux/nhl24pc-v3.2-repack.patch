+static void MarkCheckpoint(vk::CommandBuffer cmdbuf, const char* kind, const Pipeline* pipeline) {
+    if (!Checkpoints::enabled.load(std::memory_order_relaxed)) {
+        return;
+    }
+    char text[96];
