diff --git a/src/video_core/renderer_vulkan/nhl_checkpoints.h b/src/video_core/renderer_vulkan/nhl_checkpoints.h
new file mode 100644
index 0000000..abc8dd5
--- /dev/null
+++ b/src/video_core/renderer_vulkan/nhl_checkpoints.h
@@ -0,0 +1,201 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// nhlport: GPU hang locator for NVIDIA cards (VK_NV_device_diagnostic_checkpoints).
+// NHLPORT_GPU_CHECKPOINTS=1 enables it: every draw / dispatch / depth-colour copy gets a
+// checkpoint with a sequence number, and a description of it is kept in a ring buffer. When the
+// device is lost, the driver reports the last checkpoint each pipeline stage reached; those are
+// written to the log ("gpu checkpoint ..."), naming the shader the GPU stopped on.
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <atomic>
+#include <cstdarg>
+#include <cstdio>
+#include <cstdlib>
+#include <string>
+#include <string_view>
+#include <vector>
+#include "common/logging/log.h"
+#include "common/types.h"
+#include "video_core/renderer_vulkan/vk_common.h"
+
+namespace Common {
+extern void (*fatal_hook)();   // defined in common/assert.cpp, called once on a failed assert
+}
+
+namespace Vulkan::Checkpoints {
+
+inline bool Requested() {
+    static const bool requested = [] {
+        const char* env = std::getenv("NHLPORT_GPU_CHECKPOINTS");
+        return env && env[0] == '1';
+    }();
+    return requested;
+}
+
+inline std::atomic<bool> enabled{false};
+inline vk::Queue queue{};
+
+struct Entry {
+    std::atomic<u64> seq{0};
+    char text[112]{};
+};
+inline constexpr size_t RingSize = 16384;
+inline std::array<Entry, RingSize> ring{};
+inline std::atomic<u64> next_seq{1};
+
+inline void Mark(vk::CommandBuffer cmdbuf, const char* fmt, ...) {
+    if (!enabled.load(std::memory_order_relaxed)) {
+        return;
+    }
+    const u64 seq = next_seq.fetch_add(1, std::memory_order_relaxed);
+    Entry& e = ring[seq % RingSize];
+    va_list args;
+    va_start(args, fmt);
+    std::vsnprintf(e.text, sizeof(e.text), fmt, args);
+    va_end(args);
+    e.seq.store(seq, std::memory_order_release);
+    cmdbuf.setCheckpointNV(reinterpret_cast<const void*>(static_cast<uintptr_t>(seq)));
+}
+
+inline const char* Describe(u64 seq) {
+    const Entry& e = ring[seq % RingSize];
+    return e.seq.load(std::memory_order_acquire) == seq ? e.text : "(overwritten)";
+}
+
+inline void Dump() {
+    if (!enabled.load(std::memory_order_relaxed) || !queue) {
+        return;
+    }
+    static std::atomic<bool> once{false};
+    if (once.exchange(true)) {
+        return;
+    }
+    std::vector<vk::CheckpointDataNV> data;
+    try {
+        data = queue.getCheckpointDataNV();
+    } catch (...) {
+        LOG_CRITICAL(Render_Vulkan, "gpu checkpoints: query failed");
+    }
+    const auto count = data.size();
+    LOG_CRITICAL(Render_Vulkan, "gpu checkpoints: {} reported by the driver (last issued #{})",
+                 count, next_seq.load() - 1);
+    u64 reached = 0;
+    for (size_t i = 0; i < count; ++i) {
+        const u64 seq = reinterpret_cast<uintptr_t>(data[i].pCheckpointMarker);
+        reached = std::max(reached, seq);
+        LOG_CRITICAL(Render_Vulkan, "gpu checkpoint stage {}: #{} {}",
+                     vk::to_string(data[i].stage), seq, Describe(seq));
+    }
+    const u64 last = next_seq.load() - 1;
+    // The command that broke the GPU is usually just after the last one it reached.
+    if (reached && reached < last) {
+        const u64 end = std::min(last, reached + 24);
+        LOG_CRITICAL(Render_Vulkan, "gpu checkpoints after the last reached one (#{}..#{}):",
+                     reached + 1, end);
+        for (u64 s = reached + 1; s <= end; ++s) {
+            LOG_CRITICAL(Render_Vulkan, "gpu checkpoint next #{} {}", s, Describe(s));
+        }
+    }
+    for (u64 s = last > 12 ? last - 12 : 1; s <= last; ++s) {
+        LOG_CRITICAL(Render_Vulkan, "gpu checkpoint issued #{} {}", s, Describe(s));
+    }
+}
+
+
+// GPU stuck without the driver reporting a lost device (a compute shader looping forever can be
+// preempted, so Windows never resets the card): log the last commands handed to the GPU. The
+// driver is not asked for its checkpoints here - that query is only valid on a lost device.
+inline void DumpIssued(const char* why) {
+    if (!enabled.load(std::memory_order_relaxed)) {
+        LOG_CRITICAL(Render_Vulkan, "{} (turn on Diagnostics to log the last GPU commands)", why);
+        return;
+    }
+    const u64 last = next_seq.load() - 1;
+    LOG_CRITICAL(Render_Vulkan, "{}: last {} GPU commands issued:", why, last > 24 ? 24 : last);
+    for (u64 s = last > 24 ? last - 24 : 1; s <= last; ++s) {
+        LOG_CRITICAL(Render_Vulkan, "gpu checkpoint issued #{} {}", s, Describe(s));
+    }
+}
+
+// nhlport: NVIDIA Pascal (GTX 10xx, MX1xx/2xx, TITAN X, Quadro P), set by the Scheduler.
+inline std::atomic<bool> pascal_gpu{false};
+
+inline bool IsPascalName(std::string_view name) {
+    for (const std::string_view key : {"GTX 10", "GT 10", "MX1", "MX 1", "MX2", "MX 2", "TITAN X",
+                                       "Quadro P", "Tesla P"}) {
+        if (name.find(key) != std::string_view::npos) {
+            return true;
+        }
+    }
+    return false;
+}
+
+// GTX 10xx fix mode, NHLPORT_GTX10_FIX = skip | fuse | off. Default: "skip" on Pascal, "off"
+// elsewhere. skip: the texture compressor 0x96470850 (faces, helmets) does not run at all (no hang,
+// black faces); fuse: EXPERIMENT - it runs with a cap on the total loop iterations per invocation
+// (a per-loop cap did not help on a GTX 1070); off: unchanged (hangs on Pascal).
+inline std::string_view Gtx10Mode(bool is_pascal) {
+    const char* env = std::getenv("NHLPORT_GTX10_FIX");
+    if (env && env[0]) {
+        const std::string_view v{env};
+        if (v == "fuse" || v == "skip" || v == "off") {
+            return v;
+        }
+    }
+    return is_pascal ? "skip" : "off";
+}
+
+// Compute shaders not run at all. NHLPORT_SKIP_CS = comma separated hex hashes (as in "Compiling cs
+// shader 0x...") replaces the default, "none" turns it off. Default on Pascal: the texture
+// compressor 0x96470850 that never finishes there and hangs the GPU (start-up, match loading).
+inline bool SkipComputeShader(u64 hash) {
+    static const std::vector<u64> list = [] {
+        std::vector<u64> v;
+        const char* env = std::getenv("NHLPORT_SKIP_CS");
+        if (env && env[0]) {
+            std::string_view rest{env};
+            while (!rest.empty()) {
+                const size_t comma = rest.find(',');
+                std::string item{rest.substr(0, comma)};
+                if (!item.empty() && item != "none") {
+                    v.push_back(std::strtoull(item.c_str(), nullptr, 16));
+                }
+                if (comma == std::string_view::npos) {
+                    break;
+                }
+                rest.remove_prefix(comma + 1);
+            }
+        } else if (Gtx10Mode(pascal_gpu.load()) == "skip") {
+            v.push_back(0x96470850ull);
+        }
+        for (const u64 h : v) {
+            LOG_INFO(Render_Vulkan, "compute shader {:#x} will be skipped", h);
+        }
+        return v;
+    }();
+    for (const u64 h : list) {
+        if (h == hash) {
+            static std::atomic<u64> n{0};
+            const u64 k = n.fetch_add(1, std::memory_order_relaxed);
+            if (k < 10 || k % 1000 == 0) {
+                LOG_INFO(Render_Vulkan, "skipped compute shader {:#x} (#{})", hash, k);
+            }
+            return true;
+        }
+    }
+    return false;
+}
+
+// Called from Scheduler once the device and its graphics queue exist.
+inline void Init(vk::Queue graphics_queue, bool extension_enabled) {
+    if (!extension_enabled) {
+        return;
+    }
+    queue = graphics_queue;
+    enabled.store(true);
+    Common::fatal_hook = &Dump;
+    LOG_INFO(Render_Vulkan, "gpu checkpoints: on");
+}
+
+} // namespace Vulkan::Checkpoints
