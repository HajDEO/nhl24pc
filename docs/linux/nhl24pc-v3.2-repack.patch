--- /dev/null
+++ b/src/core/nhl_teams_patch.h
@@ -0,0 +1,235 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// nhlport: hidden national teams. NHL 24 ships Russia and Belarus in its team database
+// (database/t3db/nhl_game.db, "International" league) with the team table's "active" field
+// set to 0. With NHLPORT_TEAMS=1 a background thread finds the game's team tables in guest
+// memory once the database is loaded (by the layout of the field list, so it works for 1.00,
+// 1.60 and saved rosters) and sets "active" for those two teams. No game file is changed.
+#pragma once
+
+#include <atomic>
+#include <chrono>
+#include <cstdlib>
+#include <cstring>
+#include <set>
+#include <string_view>
+#include <thread>
+#include "common/logging/log.h"
+#include "common/types.h"
+#include "core/memory.h"
+
+#ifdef _WIN32
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#include <windows.h>
+#endif
+
+namespace Core::NhlTeams {
+
+#ifdef _WIN32
+struct TableView {
+    u8* fields;      // first field definition (16 bytes each: type, bit offset, name, bit length)
+    u32 num_fields;
+    u32 record_len;  // bytes
+    u32 count;
+    u8* records;
+};
+
+inline bool IsName(const u8* p) {
+    for (int i = 0; i < 4; ++i) {
+        const u8 c = p[i];
+        if (!((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9'))) {
+            return false;
+        }
+    }
+    return true;
+}
+
+inline bool Readable(const void* p, size_t n, bool write = false) {
+    MEMORY_BASIC_INFORMATION mbi{};
+    const u8* a = static_cast<const u8*>(p);
+    const u8* end = a + n;
+    while (a < end) {
+        if (!VirtualQuery(a, &mbi, sizeof(mbi)) || mbi.State != MEM_COMMIT ||
+            (mbi.Protect & (PAGE_GUARD | PAGE_NOACCESS))) {
+            return false;
+        }
+        const DWORD ok = write ? (PAGE_READWRITE | PAGE_EXECUTE_READWRITE)
+                               : (PAGE_READONLY | PAGE_READWRITE | PAGE_EXECUTE_READ |
+                                  PAGE_EXECUTE_READWRITE | PAGE_WRITECOPY);
+        if (!(mbi.Protect & ok)) {
+            return false;
+        }
+        a = static_cast<const u8*>(mbi.BaseAddress) + mbi.RegionSize;
+    }
+    return true;
+}
+
+// p points at the "kKYN" (active) field definition name; walk back to the first field and read
+// the 40-byte table header in front of it.
+inline bool ParseTable(u8* name, u8* region_begin, TableView& t) {
+    u8* f = name - 8;
+    u8* first = f;
+    while (first - 16 >= region_begin + 40 && IsName(first - 16 + 8) &&
+           *reinterpret_cast<u32*>(first - 16) <= 4) {
+        first -= 16;
+    }
+    for (int back = 0; back < 400 && first >= region_begin + 40; ++back) {
+        u8* hdr = first - 40;
+        const u32 reclen = *reinterpret_cast<u32*>(hdr + 8);
+        const u32 lenbits = *reinterpret_cast<u32*>(hdr + 12);
+        const u16 cap = *reinterpret_cast<u16*>(hdr + 20);
+        const u16 cnt = *reinterpret_cast<u16*>(hdr + 22);
+        const u8 nf = hdr[28];
+        if (nf > 0 && reclen > 0 && reclen < 8192 && (lenbits + 7) / 8 <= reclen && cnt <= cap &&
+            cap < 8192 && first + 16 * nf > f) {
+            t = {first, nf, reclen, cnt, first + 16u * nf};
+            return true;
+        }
+        first += 16;  // the backward walk overshot into the previous table: step forward again
+        if (first > f) {
+            break;
+        }
+    }
+    return false;
+}
+
+inline bool FindField(const TableView& t, const char* name, u32& type, u32& bitoff, u32& bits) {
+    for (u32 i = 0; i < t.num_fields; ++i) {
+        const u8* e = t.fields + 16 * i;
+        if (std::memcmp(e + 8, name, 4) == 0) {
+            type = *reinterpret_cast<const u32*>(e);
+            bitoff = *reinterpret_cast<const u32*>(e + 4);
+            bits = *reinterpret_cast<const u32*>(e + 12);
+            return true;
+        }
+    }
+    return false;
+}
+
+inline u32 GetBits(const u8* rec, u32 off, u32 bits) {
+    u32 v = 0;
+    for (u32 k = 0; k < bits; ++k) {
+        const u32 bit = off + k;
+        v |= ((rec[bit / 8] >> (bit % 8)) & 1u) << k;
+    }
+    return v;
+}
+
+// Returns the number of teams switched on in this table.
+inline int PatchTable(const TableView& t) {
+    u32 ta, oa, ba, tn, on, bn, tl, ol, bl;
+    if (!FindField(t, "kKYN", ta, oa, ba) || ba != 1 || !FindField(t, "AUsv", tn, on, bn) ||
+        tn != 0 || !FindField(t, "xMjj", tl, ol, bl)) {
+        return 0;
+    }
+    if (!Readable(t.records, size_t(t.record_len) * t.count)) {
+        return 0;
+    }
+    int changed = 0;
+    for (u32 r = 0; r < t.count; ++r) {
+        u8* rec = t.records + size_t(r) * t.record_len;
+        if (GetBits(rec, ol, bl) != 10) {  // league 10 = "International"
+            continue;
+        }
+        const char* name = reinterpret_cast<const char*>(rec + on / 8);
+        const bool target = std::strncmp(name, "Russia", bn / 8) == 0 ||
+                            std::strncmp(name, "Belarus", bn / 8) == 0;
+        if (!target || GetBits(rec, oa, 1)) {
+            continue;
+        }
+        if (!Readable(rec + oa / 8, 1, true)) {
+            continue;
+        }
+        rec[oa / 8] |= u8(1u << (oa % 8));
+        LOG_INFO(Core, "teams: {} switched on (table at {})", name, fmt::ptr(t.fields));
+        ++changed;
+    }
+    return changed;
+}
+
+inline int ScanOnce(int* found_out = nullptr) {
+    int found = 0;
+    static constexpr char Needle[8] = {'k', 'K', 'Y', 'N', 1, 0, 0, 0};
+    const std::string_view needle{Needle, 8};
+    auto& as = Core::Memory::Instance()->GetAddressSpace();
+    const std::pair<const u8*, u64> ranges[] = {
+        {reinterpret_cast<const u8*>(as.SystemManagedVirtualBase()), as.SystemManagedVirtualSize()},
+        {reinterpret_cast<const u8*>(as.SystemReservedVirtualBase()), as.SystemReservedVirtualSize()},
+        {reinterpret_cast<const u8*>(as.UserVirtualBase()), as.UserVirtualSize()},
+    };
+    int changed = 0;
+    for (const auto& [base, size] : ranges) {
+        if (!base || !size) {
+            continue;
+        }
+        const u8* a = base;
+        const u8* end = base + size;
+        MEMORY_BASIC_INFORMATION mbi{};
+        while (a < end && VirtualQuery(a, &mbi, sizeof(mbi))) {
+            u8* rb = static_cast<u8*>(mbi.BaseAddress);
+            const size_t rs = mbi.RegionSize;
+            a = rb + rs;
+            if (mbi.State != MEM_COMMIT || (mbi.Protect & (PAGE_GUARD | PAGE_NOACCESS)) ||
+                !(mbi.Protect & (PAGE_READWRITE | PAGE_EXECUTE_READWRITE))) {
+                continue;
+            }
+            const std::string_view hay{reinterpret_cast<const char*>(rb), rs};
+            for (size_t pos = hay.find(needle); pos != std::string_view::npos;
+                 pos = hay.find(needle, pos + 1)) {
+                TableView t{};
+                if (ParseTable(rb + pos, rb, t)) {
+                    ++found;
+                    changed += PatchTable(t);
+                }
+            }
+        }
+    }
+    if (found_out) {
+        *found_out = found;
+    }
+    return changed;
+}
+#endif
+
+inline void Start() {
+#ifdef _WIN32
+    const char* env = std::getenv("NHLPORT_TEAMS");
+    if (!env || env[0] != '1') {
+        return;
+    }
+    LOG_INFO(Core, "teams: Russia / Belarus switch-on is enabled");
+    std::thread([] {
+        const auto t0 = std::chrono::steady_clock::now();
+        int last_found = -1;
+        bool first = true;
+        for (;;) {
+            int found = 0;
+            const auto s0 = std::chrono::steady_clock::now();
+            try {
+                ScanOnce(&found);
+            } catch (...) {
+            }
+            const auto now = std::chrono::steady_clock::now();
+            const auto el = std::chrono::duration_cast<std::chrono::milliseconds>(now - t0).count();
+            if (first) {
+                LOG_INFO(Core, "teams: first scan took {} ms",
+                         std::chrono::duration_cast<std::chrono::milliseconds>(now - s0).count());
+                first = false;
+            }
+            if (found != last_found) {
+                LOG_INFO(Core, "teams: {} team table(s) in memory at {} ms", found, el);
+                last_found = found;
+            }
+            std::this_thread::sleep_for(found == 0 && el < 120000 ? std::chrono::milliseconds(50)
+                                        : el < 300000            ? std::chrono::seconds(2)
+                                                                 : std::chrono::seconds(20));
+        }
+    }).detach();
+#endif
+}
+
+} // namespace Core::NhlTeams
