+                    LogWaitRegMemSpin(name.c_str(), *wait_reg_mem,
+                                      vo_port->IsVoLabel(wait_reg_mem->Address<u64*>()),
+                                      num_submits, mapped_queues[GfxQueueId].submits.size(),
+                                      num_mapped_queues);
+                }
